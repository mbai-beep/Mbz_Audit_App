# ─────────────────────────────────────────────────────────────
# MB Store Audit App — Environment Variables
# Copy to `.env` locally or paste into Vercel Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Turso (libSQL) — serverless SQLite
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# JWT signing secret — long random string (use: openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-string

# Admin bootstrap secret — required to call /api/admin?action=* when no admin exists yet
ADMIN_SECRET=change-me

# Fast2SMS API key — for OTP delivery during forgot-password flow
FAST2SMS_API_KEY=your-fast2sms-key

# Google Service Account JSON (entire JSON pasted as ONE LINE, or with \n escapes)
# Grant this SA "Content Manager" on the Shared Drive and "Editor" on the Sheet.
GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}

# Google Drive — Shared Drive folder where audit photos are uploaded
GOOGLE_DRIVE_FOLDER_ID=0AAJ1498fVte6Uk9PVA

# Google Sheet ID — one row appended per submitted audit
GOOGLE_SHEET_ID=1_Mi3Nj12Fh3ZARua7G7ZmBApAwd5pLHBmca_YMCAJAU
GOOGLE_SHEET_TAB=Audits
